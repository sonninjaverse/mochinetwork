MONAD_CHAIN_ID=10143
MONAD_RPC_HTTP=https://testnet-rpc.monad.xyz
MONAD_RPC_WS=

IDENTITY_REGISTRY=0xa67ef35974bc8874318d249b6e74c7bd5870d1db
POST_REGISTRY=0x894a39b3Fc34106c0B4724aab8cbB459b8184D46
COMMUNITY_REGISTRY=0x41c19889a3218000482a1cd6e13640edcd16cf32
# Required with COMMUNITY_REGISTRY; use its deployment receipt's blockNumber.
COMMUNITY_DEPLOY_BLOCK=63285812
DEPLOY_BLOCK=63285812

DB_PATH=./mochi.db
PORT=8787
LOG_CHUNK_SIZE=100

# Seed data. TEAM_PRIVATE_KEY is the deployer, which is the depth-0 wallet.
SEED_MNEMONIC=
TEAM_PRIVATE_KEY=
FUND_AMOUNT=0.25

# Seed scripts only: the live indexer they check before posting.
INDEXER_URL=http://localhost:8787

# Explore default, read by seed/demo-check.ts only.
DISCOVERY_FEED=0x58298dFb756Ca8400d1d36F8268E4786C9a64d9B

# Image pinning (Pinata). Uploads are refused with 503 without it.
PINATA_JWT=

# Private gate. Unset GATE_SECRET serves everyone, as the tests and the local
# e2e stack require. With it set, every route but /health and /gate needs the
# signed cookie issued after accepting an invitation or signing in.
# GATE_CODES seeds single-use bootstrap codes; spent codes stay spent after restarts.
# Members get 3 personal codes. Issue extra bootstrap codes with npm run invites.
GATE_SECRET=
GATE_CODES=
GATE_TTL_SECONDS=2592000
GATE_COOKIE_DOMAIN=
GATE_WEB_ORIGIN=http://localhost:3000

# CORS origins allowed to send the gate cookie. Comma-separated.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Push. The private half of the VAPID pair; the public half goes in
# web/.env.production. Without these, push stays off and only the bell works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

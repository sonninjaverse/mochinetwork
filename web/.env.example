# Public browser configuration. Set before pnpm build.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:5174
NEXT_PUBLIC_INDEXER_URL=http://localhost:8787
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_HTTP=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_WS=

# Published Monad testnet deployments; use your own addresses after deploying.
NEXT_PUBLIC_IDENTITY_REGISTRY=0xa67ef35974bc8874318d249b6e74c7bd5870d1db
NEXT_PUBLIC_POST_REGISTRY=0x894a39b3Fc34106c0B4724aab8cbB459b8184D46
NEXT_PUBLIC_ALGORITHM_REGISTRY=0xFA1Db0d75b316579099eAf0A986690B68f9e8b21
NEXT_PUBLIC_COMMUNITY_REGISTRY=0x41c19889a3218000482a1cd6e13640edcd16cf32

# One-claim tMON faucet (contracts/src/Faucet.sol). Blank hides the button;
# set it after `forge script script/DeployFaucet.s.sol` and funding.
NEXT_PUBLIC_FAUCET=0x27292dd0e94b68d5d0567fd26081bac030502925

NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Blank uses the current hostname. Keep this stable for existing passkeys.
NEXT_PUBLIC_RP_ID=
# Optional; the matching private key belongs only on the indexer.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Use burner only for local tests with disposable funds. Default is passkey.
# Set to privy for external wallets plus email, or both for passkey + Privy.
NEXT_PUBLIC_WALLET=mera
# Required only when NEXT_PUBLIC_WALLET=privy. From the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional invite gate, server-only; must match the indexer's GATE_SECRET.
GATE_SECRET=

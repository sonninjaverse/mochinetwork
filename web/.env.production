# Build values for every deploy, CI included.
#
# Committed on purpose. Every name here begins NEXT_PUBLIC_, which means Next
# inlines it into the JavaScript served to every visitor — these are already
# public the moment the site is up, and keeping them in the repo is what lets
# a runner build the same bundle this machine does. Nothing without that
# prefix belongs in this file.
#
# .env.local still wins locally, so a developer can point at a different
# indexer without touching this.

NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_HTTP=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_WS=

# Redeployed 2026-09-18. See contracts/DEPLOYED.md
NEXT_PUBLIC_IDENTITY_REGISTRY=0xa67ef35974bc8874318d249b6e74c7bd5870d1db
NEXT_PUBLIC_POST_REGISTRY=0x894a39b3Fc34106c0B4724aab8cbB459b8184D46
NEXT_PUBLIC_ALGORITHM_REGISTRY=0xFA1Db0d75b316579099eAf0A986690B68f9e8b21

# Community registry deployment: block 63285812. See contracts/DEPLOYED.md
NEXT_PUBLIC_COMMUNITY_REGISTRY=0x41c19889a3218000482a1cd6e13640edcd16cf32

NEXT_PUBLIC_INDEXER_URL=http://localhost:8787

# Optional stable WebAuthn relying party; blank uses the current hostname.
NEXT_PUBLIC_RP_ID=

NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional Web Push public key; configure your own indexer key pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:5174
